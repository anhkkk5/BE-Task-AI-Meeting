NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=v1

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agile_ai
MYSQL_PASSWORD=agile_ai
MYSQL_DATABASE=agile_ai
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=2

MONGODB_ENABLED=true
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/agile_ai?retryWrites=true&w=majority&appName=<app-name>

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_SAME_SITE=
REFRESH_COOKIE_SECURE=

AI_PROVIDER=mock
OPENAI_API_KEY=

AI_DAILY_REPORT_SCHEDULER_ENABLED=false
AI_DAILY_REPORT_CRON=0 0 17 * * 1-5
AI_DAILY_REPORT_TIMEZONE=Asia/Bangkok
AI_DAILY_REPORT_INCLUDE_TEAM=true
AI_DAILY_REPORT_LOCK_TTL_SECONDS=3600

# Tao Daily Update du phong luc 00:00 cho ngay vua ket thuc neu user chua gui.
AI_DAILY_UPDATE_SCHEDULER_ENABLED=false
AI_DAILY_UPDATE_CRON=0 0 17 * * *
AI_DAILY_UPDATE_EXPIRY_CRON=0 59 23 * * *
AI_DAILY_UPDATE_REMINDER_CRON=0 0 21 * * *
AI_DAILY_UPDATE_TIMEZONE=Asia/Bangkok
AI_DAILY_UPDATE_LOCK_TTL_SECONDS=3600
AI_MODEL=gpt-5.6-luna
AI_INPUT_COST_PER_MILLION_USD=0.20
AI_OUTPUT_COST_PER_MILLION_USD=1.20
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_TRANSCRIPTION_LANGUAGE=vi
AI_TRANSCRIPTION_TIMEOUT_MS=45000
# Duong dan tuy chinh neu ffmpeg khong nam trong PATH. Docker image da cai san.
FFMPEG_PATH=ffmpeg

MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Agile AI

APP_WEB_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=agile-ai
